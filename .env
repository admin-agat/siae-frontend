# Backend LOCAL (desarrollo en la PC de oficina)
# Se usa 127.0.0.1 en vez de localhost: en Windows "localhost" intenta primero IPv6 (::1)
# y cada petición tardaba ~17 s en vez de <1 s
VITE_API_URL=http://127.0.0.1:8000/api

